---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import SearchPanel from "./SearchPanel.astro";
import IconBird from "@/assets/icons/IconBird.svg";
import LanguageToggle from "./LanguageToggle.astro";
import { SITE } from "@/config";
import type { Lang } from "@/content.config";
import { localePath, splitLocale } from "@/utils/translations";

export interface Props {
  /** The page in the other language; shows the language toggle. */
  alternate?: { lang: Lang; href: string };
}

const { alternate } = Astro.props;

// Nav links stay in the language of the current page.
const { lang: locale, path: pathname } = splitLocale(Astro.url.pathname);
const href = (path: string) => localePath(locale, path);

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-20 border-b border-transparent bg-background"
>
  <a
    id="skip-to-content"
    href="#main-content"
    class="sr-only z-50 bg-background px-3 py-2 text-accent focus:not-sr-only focus:absolute focus:start-16 focus:top-4"
  >
    Skip to content
  </a>
  <!-- Same width as the home and About pages, so the edges line up. -->
  <div
    id="nav-container"
    class="flex w-full flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative mx-auto flex min-h-[56px] w-full max-w-5xl items-baseline justify-between bg-background px-4 py-2 sm:items-center sm:py-2"
    >
      <a
        href={href("/")}
        class="absolute flex items-center gap-2 py-1 text-lg leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-xl sm:leading-none"
      >
        <IconBird aria-hidden="true" class="h-[0.9em] w-auto text-accent" />
        {SITE.title}
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <div class="flex items-center gap-1 self-end sm:hidden">
          {alternate && <LanguageToggle {...alternate} />}
          <a
            href={href("/#search")}
            data-search-toggle
            role="button"
            aria-label="Search"
            aria-expanded="false"
            aria-controls="search-panel"
            title="Search"
            class="group focus-outline flex p-2"
          >
            <IconSearch aria-hidden="true" class="group-aria-expanded:hidden" />
            <IconX
              aria-hidden="true"
              class="hidden group-aria-expanded:block"
            />
          </a>
          <button
            id="menu-btn"
            class="focus-outline p-2"
            aria-label="Open Menu"
            aria-expanded="false"
            aria-controls="menu-items"
          >
            <IconX id="close-icon" class="hidden" />
            <IconMenuDeep id="menu-icon" />
          </button>
        </div>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a
              href={href("/")}
              class:list={{
                "active-nav": isActive("/") || isActive("/posts"),
              }}
            >
              Posts
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={href("/about")}
              class:list={{ "active-nav": isActive("/about") }}
            >
              About
            </a>
          </li>
          {/* On narrow screens the search button sits next to the menu. */}
          <li class="hidden items-center justify-center sm:flex">
            <a
              href={href("/#search")}
              data-search-toggle
              role="button"
              aria-label="Search"
              aria-expanded="false"
              aria-controls="search-panel"
              title="Search"
              class="group focus-outline flex p-1"
            >
              <IconSearch
                aria-hidden="true"
                class="group-aria-expanded:hidden"
              />
              <IconX
                aria-hidden="true"
                class="hidden group-aria-expanded:block"
              />
            </a>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-2 flex items-center justify-center sm:col-span-1">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
          <li class="hidden items-center sm:flex">
            {/* Wrapped so the nav's `li > a` padding doesn't apply. */}
            <div class="flex">
              {
                alternate ? (
                  <LanguageToggle {...alternate} />
                ) : (
                  // Same box as the toggle, so the nav doesn't move.
                  <span
                    aria-hidden="true"
                    class="invisible flex w-16 justify-center px-2 py-2 text-sm font-medium sm:w-14 sm:px-1 sm:py-1"
                  >
                    English
                  </span>
                )
              }
            </div>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
<SearchPanel />
<!-- Reserves the fixed header's height (56px + 1px border) in the flow. -->
<div aria-hidden="true" class="h-[57px] shrink-0"></div>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
